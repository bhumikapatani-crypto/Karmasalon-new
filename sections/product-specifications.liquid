{{ 'section-product-specifications.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign specification = product.metafields[section.settings.metafield_namespace][section.settings.metafield_key].value
  assign rows_field = specification[section.settings.rows_key]
  assign rows = rows_field.value
  assign metaobject_image = specification[section.settings.image_key].value

  assign specification_image = section.settings.image_override
  if specification_image == blank
    assign specification_image = metaobject_image
  endif
  if specification_image == blank and section.settings.use_featured_image
    assign specification_image = product.featured_image
  endif

  assign category_field = specification[section.settings.category_key]
  assign metaobject_heading = specification[section.settings.heading_key]
  assign description_field = specification[section.settings.description_key]

  assign display_heading = section.settings.heading
  if display_heading == blank and metaobject_heading.value != blank
    assign display_heading = metaobject_heading.value
  endif
  if display_heading == blank
    assign display_heading = 'Specifications'
  endif
-%}

{%- if specification != blank and rows != blank -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --spec-section-bg: {{ section.settings.section_background }};
      --spec-media-bg: {{ section.settings.image_background }};
      --spec-table-bg: {{ section.settings.table_background }};
      --spec-heading: {{ section.settings.heading_color }};
      --spec-text: {{ section.settings.text_color }};
      --spec-muted: {{ section.settings.muted_color }};
      --spec-border: {{ section.settings.border_color }};
      --spec-image-width: {{ section.settings.image_width }}%;
      --spec-label-width: {{ section.settings.label_width }}%;
      --spec-column-gap: {{ section.settings.column_gap | times: 0.75 }}px;
      --spec-column-gap-desktop: {{ section.settings.column_gap }}px;
      --spec-media-radius: {{ section.settings.image_radius }}px;
      --spec-table-radius: {{ section.settings.table_radius }}px;
      --spec-image-padding: {{ section.settings.image_padding }}px;
      --spec-image-padding-mobile: {{ section.settings.image_padding | times: 0.65 }}px;
      --spec-image-max-height: {{ section.settings.image_max_height }}px;
      --spec-row-padding: {{ section.settings.row_padding }}px;
      --spec-row-padding-mobile: {{ section.settings.row_padding | times: 0.8 }}px;
      --spec-padding-top: {{ section.settings.padding_top }}px;
      --spec-padding-bottom: {{ section.settings.padding_bottom }}px;
      --spec-padding-top-mobile: {{ section.settings.padding_top | times: 0.65 }}px;
      --spec-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.65 }}px;
      --spec-image-fit: {{ section.settings.image_fit }};
      --spec-content-position: {{ section.settings.content_position }};
    }
  {%- endstyle -%}

  <section class="product-specifications product-specifications--image-{{ section.settings.image_position }}{% unless section.settings.show_image_mobile %} product-specifications--hide-image-mobile{% endunless %}">
    <div class="container product-specifications__inner">
      <div class="product-specifications__grid">
        {%- if specification_image != blank -%}
          <div class="product-specifications__media product-specifications__media--{{ section.settings.image_ratio }}">
            {%- capture image_sizes -%}(min-width: 750px) {{ section.settings.image_width }}vw, 100vw{%- endcapture -%}
            {{
              specification_image
              | image_url: width: 1600
              | image_tag:
                class: 'product-specifications__image',
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1100, 1300, 1600',
                sizes: image_sizes
            }}
          </div>
        {%- endif -%}

        <div class="product-specifications__content">
          {%- if section.settings.show_category and category_field.value != blank -%}
            <p class="product-specifications__eyebrow">{{ category_field.value | escape }}</p>
          {%- endif -%}

          <h2 class="product-specifications__heading heading {{ section.settings.heading_size }}">
            {{ display_heading | escape }}
          </h2>

          {%- if section.settings.description != blank -%}
            <div class="product-specifications__description rte">{{ section.settings.description }}</div>
          {%- elsif description_field.value != blank -%}
            <div class="product-specifications__description rte">
              {%- if description_field.type == 'rich_text_field' -%}
                {{ description_field | metafield_tag }}
              {%- else -%}
                {{ description_field.value | escape | newline_to_br }}
              {%- endif -%}
            </div>
          {%- endif -%}

          <dl class="product-specifications__table">
            {%- for row in rows -%}
              {%- liquid
                assign label_field = row[section.settings.row_label_key]
                assign value_field = row[section.settings.row_value_key]
              -%}
              {%- if label_field.value != blank and value_field.value != blank -%}
                <div class="product-specifications__row">
                  <dt class="product-specifications__label">{{ label_field.value | escape }}</dt>
                  <dd class="product-specifications__value">
                    {{ value_field.value | escape | newline_to_br }}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product specifications",
  "tag": "section",
  "class": "product-specifications-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Leave blank to use the metaobject heading." },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h1", "options": [
      { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" }
    ] },
    { "type": "richtext", "id": "description", "label": "Description override", "info": "Leave blank to use the metaobject description." },
    { "type": "checkbox", "id": "show_category", "label": "Show category label", "default": true },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image_override", "label": "Image override", "info": "Optional. The product's metaobject image is used by default." },
    { "type": "checkbox", "id": "use_featured_image", "label": "Use product image if metaobject image is empty", "default": true },
    { "type": "checkbox", "id": "show_image_mobile", "label": "Show image on mobile", "default": true },
    { "type": "select", "id": "image_position", "label": "Desktop image position", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "image_ratio", "label": "Image area ratio", "default": "square", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }
    ] },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [
      { "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }
    ] },
    { "type": "range", "id": "image_width", "label": "Desktop image width", "min": 30, "max": 55, "step": 1, "unit": "%", "default": 42 },
    { "type": "range", "id": "image_max_height", "label": "Desktop maximum image height", "min": 320, "max": 800, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "image_padding", "label": "Image inner spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Layout and table" },
    { "type": "select", "id": "content_position", "label": "Vertical content position", "default": "center", "options": [
      { "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Bottom" }
    ] },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 16, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "label_width", "label": "Table label width", "min": 30, "max": 55, "step": 1, "unit": "%", "default": 42 },
    { "type": "range", "id": "row_padding", "label": "Table row spacing", "min": 12, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "table_radius", "label": "Table corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 14 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#ffffff" },
    { "type": "color", "id": "table_background", "label": "Table background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading and labels", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Value text", "default": "#262626" },
    { "type": "color", "id": "muted_color", "label": "Description and note text", "default": "#666666" },
    { "type": "color", "id": "border_color", "label": "Table borders", "default": "#e1e1e1" },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },

    { "type": "header", "content": "Metaobject connection" },
    { "type": "paragraph", "content": "Defaults expect product metafield custom.specification_table and fields category_label, heading, description, image and rows." },
    { "type": "text", "id": "metafield_namespace", "label": "Product metafield namespace", "default": "custom" },
    { "type": "text", "id": "metafield_key", "label": "Product metafield key", "default": "specification_table" },
    { "type": "text", "id": "category_key", "label": "Category field key", "default": "category_label" },
    { "type": "text", "id": "heading_key", "label": "Heading field key", "default": "heading" },
    { "type": "text", "id": "description_key", "label": "Description field key", "default": "description" },
    { "type": "text", "id": "image_key", "label": "Image field key", "default": "image" },
    { "type": "text", "id": "rows_key", "label": "Rows field key", "default": "rows" },
    { "type": "text", "id": "row_label_key", "label": "Row label field key", "default": "label" },
    { "type": "text", "id": "row_value_key", "label": "Row value field key", "default": "value" }
  ],
  "presets": [{ "name": "Product specifications" }]
}
{% endschema %}
